<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TalentHub</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }
    body {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: #222;
      min-height: 100vh;
    }
    header, footer {
      background: #12355b;
      color: white;
      padding: 15px 5%;
      text-align: center;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    nav button, .btn {
      background: white;
      color: #12355b;
      border: none;
      padding: 8px 16px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
    }
    .btn-submit {
      background: #12355b;
      color: white;
      width: 100%;
      padding: 10px;
      margin-top: 10px;
    }
    .page {
      display: none;
    }
    .active {
      display: block;
    }
    .hero {
      text-align: center;
      padding: 60px 20px;
      color: white;
    }
    .form-container {
      width: 90%;
      max-width: 600px;
      margin: 20px auto;
      background: white;
      padding: 25px;
      border-radius: 8px;
    }
    .form-group {
      margin-bottom: 12px;
    }
    label {
      display: block;
      margin-bottom: 4px;
      font-weight: bold;
    }
    input, select, textarea {
      width: 100%;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    @media(max-width: 600px) {
      .row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <header>
    <h2>TalentHub</h2>
    <nav>
      <button onclick="showPage('home')">Home</button>
      <button onclick="showPage('signin')">Sign In</button>
      <button onclick="showPage('register')">Register</button>
    </nav>
  </header>
  <section id="home" class="page active hero">
    <h1>Welcome to TalentHub</h1>
    <p>Find job & internship opportunities.</p>
  </section>

  <section id="signin" class="page">
    <div class="form-container">
      <h2>Sign In</h2>
      <form onsubmit="return signIn()">
        <div class="form-group">
          <label>Email*</label>
          <input type="email" id="loginEmail" required>
        </div>
        <div class="form-group">
          <label>Password*</label>
          <input type="password" id="loginPassword" required>
        </div>
        <button class="btn btn-submit" type="submit">Sign In</button>
      </form>
    </div>
  </section>
  <section id="register" class="page">
    <div class="form-container">
      <h2>Registration</h2>
      <form onsubmit="return validateForm()">
        <div class="row">
          <div class="form-group">
            <label>Full Name*</label>
            <input type="text" id="name" required>
          </div>
          <div class="form-group">
            <label>DOB*</label>
            <input type="date" id="dob" required>
          </div>
        </div>
        <div class="row">
          <div class="form-group">
            <label>Email*</label>
            <input type="email" id="email" required>
          </div>
          <div class="form-group">
            <label>Phone*</label>
            <input type="text" id="phone" required>
          </div>
        </div>
        <div class="row">
          <div class="form-group">
            <label>Qualification*</label>
            <select id="qualification" required>
              <option value="">Select</option>
              <option>B.E / B.Tech</option>
              <option>B.Sc</option>
              <option>BCA</option>
              <option>MCA</option>
            </select>
          </div>
          <div class="form-group">
            <label>Applying For*</label>
            <select id="jobType" required>
              <option value="">Select</option>
              <option>Full Time</option>
              <option>Internship</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Skills*</label>
          <textarea id="skills" required></textarea>
        </div>
        <div class="form-group">
          <label>Resume* (PDF/DOC)</label>
          <input type="file" id="resume" accept=".pdf,.doc,.docx" required>
        </div>
        <button type="submit" class="btn btn-submit">Register</button>
      </form>
    </div>
  </section>
  <footer>
    <p>© 2026 TalentHub</p>
  </footer>
  <script>
    function showPage(id) {
      document.querySelectorAll(".page").forEach(function(p) {
        p.classList.remove("active");
      });
      document.getElementById(id).classList.add("active");
    }
    function validateForm() {
      let name = document.getElementById("name").value;
      let phone = document.getElementById("phone").value;
      let resume = document.getElementById("resume").value;
      if (!/^[A-Za-z ]{3,}$/.test(name)) {
        alert("Enter valid name!");
        return false;
      }
      if (!/^[6-9][0-9]{9}$/.test(phone)) {
        alert("Enter valid 10-digit phone number!");
        return false;
      }
      if (!/\.(pdf|doc|docx)$/i.test(resume)) {
        alert("Invalid file format!");
        return false;
      }
      alert("Registration Successful!");
      return false;
    }
    function signIn() {
      let pass = document.getElementById("loginPassword").value;
      if (pass.length < 6) {
        alert("Password must be 6+ chars!");
        return false;
      }
      alert("Sign In Successful!");
      return false;
    }
  </script>
</body>
</html>







 


 
